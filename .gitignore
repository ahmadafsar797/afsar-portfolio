# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables
.env
.env.local
.env.production

# System Files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Build output (Render will build it fresh)
dist/

# Local uploaded files (large videos / images uploaded through admin panel)
# On Render, uploads are stored on the server's ephemeral disk
uploads/*
!uploads/.gitkeep

# Local SQLite database (Render will auto-create a fresh one on first run)
data/portfolio.db

# Scratch/temp files
scratch/
